{
  "name": "calhacks13",
  "private": true,
  "workspaces": [
    "web",
    "ingest",
    "lib"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "ingest": "npm run ingest -w ingest",
    "sky-photo": "uvicorn sky_photo.main:app --reload --env-file .env --host 127.0.0.1 --port 8000",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:yonder": "tsx --tsconfig web/tsconfig.json tests/yonder-reveal.test.ts",
    "test:yonder-memory": "tsx --tsconfig web/tsconfig.json tests/yonder-memory.test.ts",
    "test:api-input": "tsx --tsconfig web/tsconfig.json tests/api-input.test.ts",
    "test:sky-catalog": "tsx lib/scripts/verify-accuracy.mts",
    "video:studio": "npm --prefix video run studio",
    "video:render": "npm --prefix video run render"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.6",
    "tsx": "^4.23.15"
  }
}
