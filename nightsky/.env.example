DATABASE_URL=postgresql://nightsky:nightsky@127.0.0.1:5432/nightsky
# Account token from https://brightdata.com/cp/setting/users
# Leave empty until you create an account. Do not commit the real value.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=mcp_unlocker
# Free-trial credits renew each UTC month and do not roll over.
BRIGHTDATA_FREE_MONTHLY_CREDITS=5000
# Prepaid balance. At $1.50 per 1,000 Unlocker credits, $300 is 200,000 credits.
BRIGHTDATA_PREPAID_USD=300
BRIGHTDATA_USD_PER_1000_CREDITS=1.50
BRIGHTDATA_SPEND_CAP_SET=1
