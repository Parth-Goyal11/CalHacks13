# xAI Grok (SpaceXAI track — Cursor + Grok Imagine/Voice APIs)
XAI_API_KEY=

# Elasticsearch Cloud Serverless (Elastic track)
ELASTIC_URL=
ELASTIC_API_KEY=

# Sky Photo FastAPI service (Astrometry + OpenCV). Next.js proxies here.
# Default matches local uvicorn: uvicorn sky_photo.main:app --reload --port 8000
SKY_PHOTO_URL=http://127.0.0.1:8000

# Required for live Astrometry.net plate-solve (annotated star labels).
# Without it, night-sky uploads still return metrics with model-estimate identity.
ASTROMETRY_API_KEY=

# Phase 3+ (Vision judge) — unused in current Sky Photo phase; leave blank for now.
VISION_API_KEY=
VISION_API_BASE=
VISION_MODEL=
